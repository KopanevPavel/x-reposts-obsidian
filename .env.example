# Required: copy this file to .env and paste your X OAuth 2.0 Client ID.
X_CLIENT_ID=

# Optional: only set this if your X app is a confidential client.
X_CLIENT_SECRET=

# Must exactly match the callback URL configured in your X Developer Portal app.
X_REDIRECT_URI=http://127.0.0.1:8765/callback

# Local file where OAuth tokens are saved. Keep this private and never commit it.
XRO_TOKEN_FILE=.xro/tokens.json

OLLAMA_BASE_URL=
XRO_LLM_MODEL=qwen3:32b
XRO_LLM_MODE=auto
XRO_LLM_CONCURRENCY=16
